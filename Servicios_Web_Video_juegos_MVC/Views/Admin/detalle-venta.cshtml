@model Servicios_Web_Video_juegos_MVC.Dto.VentaResponseDto
@{
    ViewData["Title"] = $"Detalle de Venta #{Model.IdVenta}";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css">
    <link rel="stylesheet" href="~/css/dataTable.css">
    <style>
        .tabla-oscura tbody tr,
        .tabla-oscura tbody td {
            background-color: transparent !important;
            color: white !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
        }
        .tabla-oscura tbody tr:hover td {
            background-color: rgba(255, 255, 255, 0.08) !important;
        }
    </style>
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">
        @await Html.PartialAsync("_AdminSidebar")

        <div class="flex-grow-1 p-4 w-100">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0 text-white">Detalle de Venta #@Model.IdVenta</h2>
                    <a asp-controller="Admin" asp-action="ListaVentas" class="btn btn-outline-light">
                        <i class="fa-solid fa-arrow-left"></i> Volver a Ventas
                    </a>
                </div>

                <!-- Cabecera Informativa -->
                <div class="card card-admin p-4 shadow-lg mb-4">
                    <div class="row">
                        <div class="col-md-4">
                            <span class="text-white-50">Cliente</span>
                            <h5 class="text-white mt-1">@Model.NombreCliente</h5>
                        </div>
                        <div class="col-md-4">
                            <span class="text-white-50">Fecha de Venta</span>
                            <h5 class="text-white mt-1">@Model.FechaVenta.ToString("dd/MM/yyyy HH:mm:ss")</h5>
                        </div>
                        <div class="col-md-4">
                            <span class="text-white-50">Total Facturado</span>
                            <h4 class="mt-1" style="color: var(--color-acento-principal); font-weight: bold;">
                                @string.Format("S/. {0:N2}", Model.MontoTotal)
                            </h4>
                        </div>
                    </div>
                </div>

                <!-- Tabla de Productos Comprados -->
                <div class="card card-admin p-4 shadow-lg text-white border-secondary">
                    <h4 class="mb-3 text-white">Juegos Incluidos</h4>
                    <table class="table table-hover align-middle tabla-oscura">
                        <thead class="table-dark">
                            <tr>
                                <th>Imagen</th>
                                <th>Juego</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">Precio Unitario</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Detalles)
                            {
                                <tr>
                                    <td>
                                        <img src="~/uploads/ImgJuegos/@d.Imagen"
                                             style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px; border: 1px solid #444;"
                                             onerror="this.src='/images/no-image.png';" />
                                    </td>
                                    <td>@d.NombreJuego</td>
                                    <td class="text-center">@d.Cantidad</td>
                                    <td class="text-end">@string.Format("S/. {0:N2}", d.Precio)</td>
                                    <td class="text-end fw-bold">@string.Format("S/. {0:N2}", d.Cantidad * d.Precio)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</body>