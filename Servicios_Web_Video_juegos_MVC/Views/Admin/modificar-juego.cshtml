@model Juego
@{
    ViewData["Title"] = "Modificar Juego";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css">
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">
        @await Html.PartialAsync("_AdminSidebar")

        <div class="flex-grow-1 p-4">
            <div class="container" style="max-width: 900px;">
                <h2 class="mb-4 text-white">Modificar Juego #@Model?.IdJuegos</h2>

                <div class="card card-admin p-4 shadow-lg text-white border-secondary">
                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Mensaje</div>
                    }

                    <form asp-controller="Admin" asp-action="ModificarJuego" asp-route-id="@Model?.IdJuegos" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="IdJuegos" />
                        <input type="hidden" asp-for="Imagen" />
                        <input type="hidden" asp-for="Activo" />

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label">Nombre / Descripción del Juego</label>
                                <input type="text" class="form-control" asp-for="Descripcion" required />
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Categoría</label>
                                <select class="form-select" asp-for="IdCategoria" asp-items="ViewBag.Categorias" required>
                                    <option value="">--Seleccione Categoría--</option>
                                </select>
                                <span asp-validation-for="IdCategoria" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Precio</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark text-white border-secondary">S/.</span>
                                    <input type="number" step="0.01" class="form-control" asp-for="Precio" required />
                                </div>
                                <span asp-validation-for="Precio" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label">Cambiar Imagen (Opcional)</label>
                                <input type="file" name="file" class="form-control" accept="image/*" />
                                
                                @if (!string.IsNullOrEmpty(Model?.Imagen))
                                {
                                    <div class="d-flex align-items-center gap-3 mt-3">
                                        <img src="~/uploads/ImgJuegos/@Model.Imagen" 
                                             alt="Imagen actual" 
                                             style="width: 70px; height: 70px; object-fit: cover; border-radius: 6px; border: 1px solid #444;"
                                             onerror="this.src='/images/no-image.png';" />
                                        <small class="text-muted">Imagen actual: <span class="text-light">@Model.Imagen</span></small>
                                    </div>
                                }
                            </div>
                        </div>

                        <hr class="border-secondary mb-4">

                        <div class="d-flex justify-content-end">
                            <a asp-controller="Admin" asp-action="ListaJuegos" class="btn btn-outline-light me-2">
                                <i class="fa-solid fa-reply"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-floppy-disk"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>