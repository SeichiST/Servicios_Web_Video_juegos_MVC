@model Categoria
@{
    ViewData["Title"] = "Registrar Categoría";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin.css">
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">

        @await Html.PartialAsync("_AdminSidebar")

        <div class="flex-grow-1 p-4">
            <div class="container" style="max-width: 700px;">
                <h2 class="mb-4">Registrar Categoría</h2>

                <div class="card card-admin p-4 shadow-lg text-white border-secondary">

                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Mensaje</div>
                    }

                    <form asp-controller="Admin" asp-action="RegistrarCategoria" method="post">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">ID Categoría</label>
                                <input type="text" class="form-control" asp-for="IdCategoria" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Descripción</label>
                                <input type="text" class="form-control" asp-for="Descripcion" required>
                            </div>
                        </div>

                        <hr class="border-secondary mb-4">

                        <div class="d-flex justify-content-end">
                            <a asp-controller="Admin" asp-action="ListaCategorias" class="btn btn-outline-light me-2">Cancelar</a>
                            <button type="submit" class="btn btn-success">Registrar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
