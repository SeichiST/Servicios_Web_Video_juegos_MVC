@model List<Categoria>
@{
    ViewData["Title"] = "Gestión de Categorías";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.bootstrap5.css">
    <link rel="stylesheet" href="~/css/admin.css">
    <link rel="stylesheet" href="~/css/dataTable.css">
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">

        @await Html.PartialAsync("_AdminSidebar")

        <div class="flex-grow-1 p-4 w-100">
            <div class="container">

                @if (TempData["Mensaje"] != null) {
                    <div class="alert alert-success">@TempData["Mensaje"]</div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">Gestión de Categorías</h2>
                    <a asp-controller="Admin" asp-action="RegistrarCategoria" class="btn btn-success px-4 py-2">
                        <i class="bi bi-plus-circle"></i> Nueva Categoría
                    </a>
                </div>

                <div class="card card-admin p-4 shadow-lg">
                    <table id="tbl-categorias" class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID Categoría</th>
                                <th>Descripción</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var categoria in Model) {
                                <tr>
                                    <td>@categoria.IdCategoria</td>
                                    <td>@categoria.Descripcion</td>
                                    <td class="text-center">
                                        <a asp-controller="Admin" asp-action="ModificarCategoria" asp-route-id="@categoria.IdCategoria"
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.bootstrap5.js"></script>
    <script>
        $(document).ready(function () {
            $('#tbl-categorias').DataTable({
                language: {
                    lengthMenu: "Mostrar _MENU_ categorías",
                    zeroRecords: "No se encontraron categorías",
                    info: "Mostrando _END_ categorías de _TOTAL_",
                    infoEmpty: "Mostrando 0 categorías",
                    infoFiltered: "(filtrado de _MAX_ categorías en total)",
                    search: "Buscar categoría:",
                    paginate: { first: "Primero", last: "Último", next: "Siguiente", previous: "Anterior" }
                },
                pageLength: 10,
                lengthMenu: [5, 10, 20, 50],
                columnDefs: [{ targets: [2], orderable: false }]
            });
        });
    </script>
</body>
