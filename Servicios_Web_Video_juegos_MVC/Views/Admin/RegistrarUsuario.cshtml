@model Cliente
@{
    ViewData["Title"] = "Registrar Usuario";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin.css">
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">

        @await Html.PartialAsync("_AdminSidebar")

        <div class="flex-grow-1 p-4">
            <div class="container" style="max-width: 900px;">
                <h2 class="mb-4">Registrar Usuario</h2>

                <div class="card card-admin p-4 shadow-lg text-white border-secondary">

                    @if (ViewBag.Mensaje != null) {
                        <div class="alert alert-danger">@ViewBag.Mensaje</div>
                    }

                    <form asp-controller="Admin" asp-action="RegistrarUsuario" method="post">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Nombres</label>
                                <input type="text" class="form-control" asp-for="Nombres" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Apellidos</label>
                                <input type="text" class="form-control" asp-for="Apellidos" required>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">DNI</label>
                                <input type="text" class="form-control" asp-for="Dni" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <input type="text" class="form-control" asp-for="Telefono" required>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Correo</label>
                                <input type="email" class="form-control" asp-for="Correo" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Contraseña</label>
                                <input type="password" class="form-control" asp-for="Password" required>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Sexo</label>
                                <select class="form-select" asp-for="Sexo">
                                    <option value="M">Masculino</option>
                                    <option value="F">Femenino</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha de Nacimiento</label>
                                <input type="date" class="form-control" asp-for="FechaNacimiento" required>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label">Dirección</label>
                                <input type="text" class="form-control" asp-for="Direccion" required>
                            </div>
                        </div>

                        <input type="hidden" asp-for="Estado" value="1">

                        <hr class="border-secondary mb-4">

                        <div class="d-flex justify-content-end">
                            <a asp-controller="Admin" asp-action="ListaUsuarios" class="btn btn-outline-light me-2">Cancelar</a>
                            <button type="submit" class="btn btn-success">Registrar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>