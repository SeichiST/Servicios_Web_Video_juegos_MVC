@model Juego
@{
    ViewData["Title"] = "Registrar Juego";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css">
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">
        @await Html.PartialAsync("_AdminSidebar")

        <div class="flex-grow-1 p-4">
            <div class="container" style="max-width: 900px;">
                <h2 class="mb-4 text-white">Registrar Nuevo Juego</h2>

                <div class="card card-admin p-4 shadow-lg text-white border-secondary">
                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Mensaje</div>
                    }

                    <form asp-controller="Admin" asp-action="RegistrarJuego" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label">Nombre del Juego</label>
                                <input type="text" class="form-control" asp-for="Descripcion" required />
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-white">Categoría</label>
                                <select class="form-select" asp-for="IdCategoria" asp-items="ViewBag.Categorias" required>
                                    <option value="">--Seleccione Categoría--</option>
                                </select>
                                <span asp-validation-for="IdCategoria" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Precio</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark text-white border-secondary">S/.</span>
                                    <input type="number" step="0.01" class="form-control" asp-for="Precio" required />
                                </div>
                                <span asp-validation-for="Precio" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label">Imagen del Juego</label>
                                <input type="file" name="file" class="form-control" accept="image/*" />
                            </div>
                        </div>

                        <hr class="border-secondary mb-4">

                        <div class="d-flex justify-content-end">
                            <a asp-controller="Admin" asp-action="ListaJuegos" class="btn btn-outline-light me-2">
                                <i class="fa-solid fa-reply"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fa-solid fa-floppy-disk"></i> Registrar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>