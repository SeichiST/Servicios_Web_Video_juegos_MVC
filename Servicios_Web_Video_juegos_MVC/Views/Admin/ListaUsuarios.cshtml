@model List<Cliente>
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.bootstrap5.css">
    <link rel="stylesheet" href="~/css/admin.css">
    <link rel="stylesheet" href="~/css/dataTable.css">
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">

        @await Html.PartialAsync("_AdminSidebar")

        <div class="flex-grow-1 p-4 w-100">
            <div class="container">

                @if (TempData["Mensaje"] != null) {
                    <div class="alert alert-success">@TempData["Mensaje"]</div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">Gestión de Usuarios</h2>
                    <a asp-controller="Admin" asp-action="RegistrarUsuario" class="btn btn-success px-4 py-2">
                        <i class="bi bi-person-plus-fill"></i> Registrar
                    </a>
                </div>

                <div class="row mb-3">
                    <fieldset class="border border-2 border-dark pb-2">
                        <legend class="float-none w-auto px-2">Filtro</legend>
                        <form asp-controller="Admin" asp-action="ListaUsuarios" method="get">
                            <div class="row align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label">Estado</label>
                                    <select class="form-select" name="estado">
                                        <option value="">--Todos--</option>
                                        <option value="1" selected="@(ViewBag.EstadoSel == "1")">Activo</option>
                                        <option value="0" selected="@(ViewBag.EstadoSel == "0")">Inactivo</option>
                                    </select>
                                </div>
                                <div class="col-md-6 text-end">
                                    <button type="submit" class="btn btn-outline-light">
                                        <i class="bi bi-search"></i> Buscar
                                    </button>
                                    <a asp-controller="Admin" asp-action="ListaUsuarios" class="btn btn-outline-secondary">
                                        <i class="bi bi-eraser"></i> Limpiar
                                    </a>
                                </div>
                            </div>
                        </form>
                    </fieldset>
                </div>

                <div class="card card-admin p-4 shadow-lg">
                    <table id="tbl-usuarios" class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre Completo</th>
                                <th>Correo</th>
                                <th>Teléfono</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model) {
                                <tr>
                                    <td>@cliente.IdCliente</td>
                                    <td>@cliente.Nombres @cliente.Apellidos</td>
                                    <td>@cliente.Correo</td>
                                    <td>@cliente.Telefono</td>
                                    <td>
                                        @if (cliente.Estado == "1") {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Admin" asp-action="ModificarUsuario" asp-route-id="@cliente.IdCliente"
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.bootstrap5.js"></script>
    <script>
            $(document).ready(function () {
                $('#tbl-usuarios').DataTable({
                    language: {
                        lengthMenu: "Mostrar _MENU_ usuarios",
                        zeroRecords: "No se encontraron usuarios",
                        info: "Mostrando _END_ usuarios de _TOTAL_",
                        infoEmpty: "Mostrando 0 usuarios",
                        infoFiltered: "(filtrado de _MAX_ usuarios en total)",
                        search: "Buscar usuario:",
                        paginate: { first: "Primero", last: "Último", next: "Siguiente", previous: "Anterior" }
                    },
                    pageLength: 10,
                    lengthMenu: [5, 10, 20, 50],
                    columnDefs: [{ targets: [5], orderable: false }]
                });
            });
    </script>
</body>