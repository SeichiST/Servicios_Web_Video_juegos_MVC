@model Cliente
@{
    ViewData["Title"] = "Editar Usuario";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin.css">
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">

        @await Html.PartialAsync("_AdminSidebar")

        <div class="flex-grow-1 p-4">
            <div class="container" style="max-width: 900px;">
                <h2 class="mb-4 text-white">Editar Usuario</h2>

                <div class="card card-admin p-4 shadow-lg bg-dark text-white border-secondary">

                    @if (ViewBag.Mensaje != null) {
                        <div class="alert alert-danger">@ViewBag.Mensaje</div>
                    }

                    <form asp-controller="Admin" asp-action="ModificarUsuario" asp-route-id="@Model.IdCliente" method="post">
                        <input type="hidden" asp-for="IdCliente">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-light fw-bold">ID Cliente</label>
                                <input type="text" class="form-control bg-secondary text-white border-0" value="@Model.IdCliente" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-light fw-bold">Estado</label>
                                <select class="form-select bg-dark text-white border-secondary" asp-for="Estado">
                                    <option value="1">Activo</option>
                                    <option value="0">Bloqueado / Inactivo</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-light fw-bold">Nombres</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" asp-for="Nombres" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-light fw-bold">Apellidos</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" asp-for="Apellidos" required>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-light fw-bold">DNI</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" asp-for="Dni" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-light fw-bold">Teléfono</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" asp-for="Telefono" required>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-light fw-bold">Correo</label>
                                <input type="email" class="form-control bg-dark text-white border-secondary" asp-for="Correo" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-light fw-bold">Sexo</label>
                                <select class="form-select bg-dark text-white border-secondary" asp-for="Sexo">
                                    <option value="M">Masculino</option>
                                    <option value="F">Femenino</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-light fw-bold">Fecha de Nacimiento</label>
                                <input type="date" class="form-control bg-dark text-white border-secondary" asp-for="FechaNacimiento" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-light fw-bold">Dirección</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" asp-for="Direccion" required>
                            </div>
                        </div>

                        <hr class="border-secondary mb-4">

                        <div class="d-flex justify-content-end">
                            <a asp-controller="Admin" asp-action="ListaUsuarios" class="btn btn-outline-light me-2">Cancelar</a>
                            <button type="submit" class="btn btn-success">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>