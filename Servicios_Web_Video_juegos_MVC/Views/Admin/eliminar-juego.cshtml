@model Juego
@{
    ViewData["Title"] = "Eliminar Juego";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css">
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">
        @await Html.PartialAsync("_AdminSidebar")

        <div class="flex-grow-1 p-4">
            <div class="container" style="max-width: 700px;">
                <h2 class="mb-4 text-danger">Eliminar Juego</h2>

                <div class="card card-admin p-4 shadow-lg text-white border-danger">
                    <p class="fs-5 mb-4">¿Estás seguro de que deseas dar de baja este juego?</p>

                    <dl class="row">
                        <dt class="col-sm-4 text-muted">ID Juego:</dt>
                        <dd class="col-sm-8">@Model?.IdJuegos</dd>

                        <dt class="col-sm-4 text-muted">Descripción:</dt>
                        <dd class="col-sm-8">@Model?.Descripcion</dd>

                        <dt class="col-sm-4 text-muted">Precio:</dt>
                        <dd class="col-sm-8">@string.Format("S/. {0:N2}", Model?.Precio)</dd>

                        @if (!string.IsNullOrEmpty(Model?.Imagen))
                        {
                            <dt class="col-sm-4 text-muted">Imagen:</dt>
                            <dd class="col-sm-8">
                                <img src="~/uploads/ImgJuegos/@Model.Imagen" 
                                     style="width: 70px; height: 70px; object-fit: cover; border-radius: 6px; border: 1px solid #444;"
                                     onerror="this.src='/images/no-image.png';" />
                            </dd>
                        }
                    </dl>

                    <form asp-controller="Admin" asp-action="EliminarJuegoPost" asp-route-id="@Model?.IdJuegos" method="post">
                        <hr class="border-secondary mb-4">

                        <div class="d-flex justify-content-end">
                            <a asp-controller="Admin" asp-action="ListaJuegos" class="btn btn-outline-light me-2">
                                <i class="fa-solid fa-reply"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fa-solid fa-trash"></i> Confirmar Eliminación
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>