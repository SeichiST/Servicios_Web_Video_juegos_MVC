@model IEnumerable<Juego>
@{
    ViewData["Title"] = "Listado de Juegos";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.bootstrap5.css">
    <link rel="stylesheet" href="~/css/admin.css">
    <link rel="stylesheet" href="~/css/dataTable.css">
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">
        @await Html.PartialAsync("_AdminSidebar")

        <div class="flex-grow-1 p-4 w-100">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0 text-white">Gestión de Juegos</h2>
                    <a asp-controller="Admin" asp-action="RegistrarJuego" class="btn btn-success px-4 py-2">
                        <i class="fa-solid fa-plus"></i> Nuevo Juego
                    </a>
                </div>

                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        @TempData["Mensaje"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="row mb-3">
                    <div class="col-md-12">
                        <fieldset class="border border-secondary p-3 rounded text-white" style="background-color: rgba(0,0,0,0.2);">
                            <legend class="float-none w-auto px-2 fs-6">Filtrar por Categoría</legend>
                            <form asp-controller="Admin" asp-action="ListaJuegos" method="get">
                                <div class="row align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label">Categoría</label>
                                        <select name="idCategoria" class="form-select" asp-items="ViewBag.Categorias">
                                            <option value="">--Todas las Categorías--</option>
                                        </select>
                                    </div>
                                    <div class="col-md-8 text-end mt-3 mt-md-0">
                                        <button type="submit" class="btn btn-outline-light me-2">
                                            <i class="fa-solid fa-filter"></i> Filtrar
                                        </button>
                                        <a asp-controller="Admin" asp-action="ListaJuegos" class="btn btn-outline-secondary">
                                            <i class="fa-solid fa-broom"></i> Limpiar
                                        </a>
                                    </div>
                                </div>
                            </form>
                        </fieldset>
                    </div>
                </div>

                <div class="card card-admin p-4 shadow-lg text-white border-secondary">
                    <table id="tbl-juegos" class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Imagen</th>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th>Precio</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <img src="~/uploads/ImgJuegos/@item.Imagen"
                                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px; border: 1px solid #444;"
                                                 onerror="this.src='/images/no-image.png';" />
                                        </td>
                                        <td>@item.IdJuegos</td>
                                        <td>@item.Descripcion</td>
                                        <td>@(item.Categoria?.Descripcion ?? "Sin Categoría")</td>
                                        <td>@string.Format("S/. {0:N2}", item.Precio)</td>
                                        <td class="text-center">
                                            <a asp-controller="Admin" asp-action="ModificarJuego" asp-route-id="@item.IdJuegos" class="btn btn-sm btn-primary">
                                                <i class="fa-solid fa-pen"></i> Editar
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.bootstrap5.js"></script>
    <script>
        $(document).ready(function () {
            $('#tbl-juegos').DataTable({
                language: {
                    search: "Buscar Juego:",
                    lengthMenu: "Mostrar _MENU_ juegos",
                    zeroRecords: "No se encontraron juegos",
                    info: "Mostrando _END_ juegos de _TOTAL_ ",
                    infoEmpty: "Mostrando 0 juegos",
                    infoFiltered: "(filtrado de _MAX_ juegos en total)",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
                },
                pageLength: 10,
                lengthMenu: [5, 10, 20, 50],
                ordering: true,
                responsive: true,
                columnDefs: [
                    { targets: [0, 4], orderable: false }
                ]
            });
        });
    </script>
</body>