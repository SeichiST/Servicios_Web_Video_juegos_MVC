<!-- Carga de Bootstrap y Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<header class="navbar p-3 navbar-dark bg-custom-pink">
    <div class="container-fluid d-flex align-items-center">

        <a asp-controller="Producto" asp-action="Inicio">
            <img src="~/img/logo.png" alt="Logo MundoGamer">
        </a>

        <form class="d-flex BarraBusqueda ms-3" role="search" asp-controller="Producto" asp-action="Juegos" method="get">
            <input name="nombre" id="Buscar" class="form-control me-2 custom-search-input" type="search" placeholder="Buscar juego...">
        </form>

        <div id="menu" class="d-flex justify-content-center flex-grow-1">
            <ul id="Barra" class="navbar-nav d-flex flex-row mb-0">
                <li class="nav-item mx-4"><a class="nav-link" asp-controller="Producto" asp-action="Inicio">Inicio</a></li>
                <li class="nav-item mx-4"><a class="nav-link" asp-controller="Producto" asp-action="Nosotros">Sobre nosotros</a></li>
                <li class="nav-item mx-4"><a class="nav-link" asp-controller="Producto" asp-action="Juegos">Juegos</a></li>
                <li class="nav-item mx-4"><a class="nav-link" asp-controller="Producto" asp-action="Contactanos">Contactanos</a></li>
                <li class="nav-item mx-4"><a class="nav-link" asp-controller="Login" asp-action="Logout">Cerrar sesión</a></li>
            </ul>
        </div>
    </div>
</header>