@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json.Linq

@{
    string? usuario = Context.Session.GetString("UsuarioLogueado");
    string? rol = Context.Session.GetString("Rol") ?? "";
    string? clienteJson = Context.Session.GetString("DatosClienteJson");
    string nombreMostrar = !string.IsNullOrEmpty(usuario) ? usuario : "Usuario";

    if (!string.IsNullOrWhiteSpace(clienteJson) && clienteJson != "undefined")
    {
        try
        {
            var json = JObject.Parse(clienteJson);
            string nombres = (string)json["nombres"] ?? (string)json["Nombres"] ?? "";
            if (!string.IsNullOrEmpty(nombres))
            {
                nombreMostrar = nombres;
            }
            string rolJson = (string)json["rol"] ?? (string)json["Rol"] ?? (string)json["tipo"] ?? "";
            if (!string.IsNullOrEmpty(rolJson))
            {
                rol = rolJson;
            }
        }
        catch { }
    }

    bool esAdmin = rol.ToUpper().Contains("ADMIN") || (usuario != null && usuario.ToLower().Contains("admin"));
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<header class="navbar p-3 navbar-dark bg-custom-pink">
    <div class="container-fluid d-flex align-items-center">

        <a asp-controller="Producto" asp-action="Inicio">
            <img src="~/img/logo.png" alt="Logo MundoGamer" style="max-height: 45px;">
        </a>

        <form class="d-flex BarraBusqueda ms-3" role="search" asp-controller="Producto" asp-action="Juegos" method="get">
            <input name="nombre" id="Buscar" class="form-control me-2 custom-search-input" type="search" placeholder="Buscar juego..." value="@Context.Request.Query["nombre"]">
            <button class="btn btn-outline-light" type="submit">
                <i class="bi bi-search"></i>
            </button>
        </form>

        <div id="menu" class="d-flex justify-content-center flex-grow-1">
            <ul id="Barra" class="navbar-nav d-flex flex-row mb-0 align-items-center">
                <li class="nav-item mx-3"><a class="nav-link text-white" asp-controller="Producto" asp-action="Inicio">Inicio</a></li>
                <li class="nav-item mx-3"><a class="nav-link text-white" asp-controller="Producto" asp-action="Nosotros">Sobre nosotros</a></li>
                <li class="nav-item mx-3"><a class="nav-link text-white" asp-controller="Producto" asp-action="Juegos">Juegos</a></li>
                <li class="nav-item mx-3"><a class="nav-link text-white" asp-controller="Producto" asp-action="Contactanos">Contactanos</a></li>
                <li class="nav-item mx-3"><a class="nav-link text-white" asp-controller="Carrito" asp-action="VerCarrito"><i class="bi bi-cart3"></i> Carrito</a></li>

                <!-- DROPDOWN  -->
                @if (!string.IsNullOrEmpty(usuario))
                {
                    <li class="nav-item mx-3 dropdown position-relative">
                        <button class="btn btn-warning btn-sm dropdown-toggle" type="button" id="userMenuBtn" onclick="toggleUserDropdown()">
                            <i class="bi bi-person-circle me-1"></i> @nombreMostrar
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow" id="userDropdownList" style="position: absolute; right: 0; margin-top: 8px;">
                            <li>
                                <a class="dropdown-item" asp-controller="Carrito" asp-action="VerCarrito">
                                    <i class="bi bi-bag-check me-2"></i> Mis Compras
                                </a>
                            </li>

                            @if (esAdmin)
                            {
                                <li>
                                    <a class="dropdown-item text-primary fw-bold" asp-controller="Admin" asp-action="ListaJuegos">
                                        <i class="bi bi-speedometer2 me-2"></i> Panel Admin
                                    </a>
                                </li>
                            }

                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="Login" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item mx-2"><a class="btn btn-outline-light btn-sm" asp-controller="Login" asp-action="Index">Iniciar Sesión</a></li>
                }
            </ul>
        </div>

    </div>
</header>

<script>
    function toggleUserDropdown() {
        var menu = document.getElementById("userDropdownList");
        if (menu) {
            menu.classList.toggle("show");
        }
    }
    window.addEventListener("click", function (e) {
        var btn = document.getElementById("userMenuBtn");
        var menu = document.getElementById("userDropdownList");
        if (btn && menu && !btn.contains(e.target) && !menu.contains(e.target)) {
            menu.classList.remove("show");
        }
    });
</script>