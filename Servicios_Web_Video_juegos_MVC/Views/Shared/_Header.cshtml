@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json.Linq

@{
    string? usuario = Context.Session.GetString("UsuarioLogueado");
    string? rol = Context.Session.GetString("Rol") ?? "";
    string? clienteJson = Context.Session.GetString("DatosClienteJson");
    string nombreMostrar = !string.IsNullOrEmpty(usuario) ? usuario : "Usuario";

    if (!string.IsNullOrWhiteSpace(clienteJson) && clienteJson != "undefined")
    {
        try
        {
            var json = JObject.Parse(clienteJson);
            string nombres = (string)json["nombres"] ?? (string)json["Nombres"] ?? "";
            if (!string.IsNullOrEmpty(nombres))
            {
                nombreMostrar = nombres;
            }
            string rolJson = (string)json["rol"] ?? (string)json["Rol"] ?? (string)json["tipo"] ?? "";
            if (!string.IsNullOrEmpty(rolJson))
            {
                rol = rolJson;
            }
        }
        catch { }
    }

    bool esAdmin = rol.ToUpper().Contains("ADMIN") || (usuario != null && usuario.ToLower().Contains("admin"));
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<header class="navbar p-3 navbar-dark bg-custom-pink">
    <div class="container-fluid d-flex align-items-center">

        <a asp-controller="Producto" asp-action="Inicio">
            <img src="~/img/logo.png" alt="Logo MundoGamer" style="max-height: 45px;">
        </a>

        <form class="d-flex BarraBusqueda ms-3" role="search" asp-controller="Producto" asp-action="Juegos" method="get">
            <input name="nombre" id="Buscar" class="form-control me-2 custom-search-input" type="search" placeholder="Buscar juego..." value="@Context.Request.Query["nombre"]">
            <button class="btn btn-outline-light" type="submit">
                <i class="bi bi-search"></i>
            </button>
        </form>

        <div id="menu" class="d-flex justify-content-center flex-grow-1">
            <ul id="Barra" class="navbar-nav d-flex flex-row mb-0 align-items-center">
                <li class="nav-item mx-3"><a class="nav-link text-white" asp-controller="Producto" asp-action="Inicio">Inicio</a></li>
                <li class="nav-item mx-3"><a class="nav-link text-white" asp-controller="Producto" asp-action="Nosotros">Sobre nosotros</a></li>
                <li class="nav-item mx-3"><a class="nav-link text-white" asp-controller="Producto" asp-action="Juegos">Juegos</a></li>
                <li class="nav-item mx-3"><a class="nav-link text-white" asp-controller="Producto" asp-action="Contactanos">Contactanos</a></li>


                <!-- DROPDOWN  -->
                @if (!string.IsNullOrEmpty(usuario))
                {
                    <li class="nav-item mx-3 dropdown position-relative">
                        <button class="btn btn-warning btn-sm dropdown-toggle" type="button" id="userMenuBtn" onclick="toggleUserDropdown()">
                            <i class="bi bi-person-circle me-1"></i> @nombreMostrar
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow" id="userDropdownList" style="position: absolute; right: 0; margin-top: 8px;">
                            <li>
                                <a class="dropdown-item" asp-controller="Carrito" asp-action="VerCarrito">
                                    <i class="bi bi-bag-check me-2"></i> Mis Compras
                                </a>
                            </li>

                            @if (esAdmin)
                            {
                                <li>
                                    <a class="dropdown-item text-primary fw-bold" asp-controller="Admin" asp-action="ListaJuegos">
                                        <i class="bi bi-speedometer2 me-2"></i> Panel Admin
                                    </a>
                                </li>
                            }

                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="Login" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item mx-2"><a class="btn btn-outline-light btn-sm" asp-controller="Login" asp-action="Index">Iniciar Sesión</a></li>
                }
            </ul>
        </div>

    </div>
</header>

<script>
    function toggleUserDropdown() {
        var menu = document.getElementById("userDropdownList");
        if (menu) {
            menu.classList.toggle("show");
        }
    }
    window.addEventListener("click", function (e) {
        var btn = document.getElementById("userMenuBtn");
        var menu = document.getElementById("userDropdownList");
        if (btn && menu && !btn.contains(e.target) && !menu.contains(e.target)) {
            menu.classList.remove("show");
        }
    });
</script>
@{
    var correoActual = Context.Session.GetString("UsuarioLogueado");
}
@if (!string.IsNullOrEmpty(correoActual))
{
    <div id="chatBubble" style="position: fixed; bottom: 24px; right: 24px; z-index: 1050;">
        <button id="btnAbrirChat" class="btn rounded-circle shadow" style="width: 60px; height: 60px; background-color:#E91E8C; border:none;">
            <i class="bi bi-chat-dots-fill text-white fs-4"></i>
        </button>
    </div>

    <div id="chatPanel" style="display:none; flex-direction:column; position: fixed; bottom: 96px; right: 24px; width: 320px; height: 420px; background: white; border-radius: 12px; z-index: 1050; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.25);">
        <div style="background-color:#E91E8C; color:white; padding: 12px 16px; font-weight:bold;">
            Chat de soporte
            <button id="btnCerrarChat" class="btn-close btn-close-white float-end"></button>
        </div>
        <div id="chatMensajes" style="flex:1; overflow-y:auto; padding: 10px; font-size: 14px; background:#f8f9fa;"></div>
        <div style="display:flex; border-top:1px solid #eee;">
            <input id="chatInput" type="text" class="form-control border-0" placeholder="Escribe un mensaje..." />
            <button id="btnEnviarChat" class="btn" style="background-color:#E91E8C; color:white;">Enviar</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const nombreUsuario = "@Html.Raw(nombreMostrar)";

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        connection.on("RecibirMensaje", function(remitente, texto) {
            const div = document.getElementById("chatMensajes");
            const esPropio = remitente === nombreUsuario;
            div.innerHTML += `<div style="margin-bottom:8px; text-align:${esPropio ? 'right' : 'left'};">
                        <div style="display:inline-block; background:${esPropio ? '#E91E8C' : '#e9ecef'}; color:${esPropio ? 'white' : 'black'}; padding:6px 10px; border-radius:10px; max-width:80%;">
                            <strong style="font-size:11px; display:block;">${esPropio ? 'Tú' : remitente}</strong>${texto}
                        </div>
                    </div>`;
            div.scrollTop = div.scrollHeight;
        });

        connection.start().catch(err => console.error(err.toString()));

        document.getElementById('btnAbrirChat').addEventListener('click', function() {
            document.getElementById('chatPanel').style.display = 'flex';
        });
        document.getElementById('btnCerrarChat').addEventListener('click', function() {
            document.getElementById('chatPanel').style.display = 'none';
        });

        function enviarMensajeChat() {
            const input = document.getElementById('chatInput');
            const texto = input.value.trim();
            if (texto === '') return;
            connection.invoke("EnviarMensaje", nombreUsuario, texto);
            input.value = '';
        }
        document.getElementById('btnEnviarChat').addEventListener('click', enviarMensajeChat);
        document.getElementById('chatInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') enviarMensajeChat();
        });
    </script>
}